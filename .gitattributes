# Fijar LF en los archivos que corren dentro de contenedores Linux, sin
# importar el sistema operativo desde el que se clone o suba el repositorio.
# Sin esto, un checkout en Windows con core.autocrlf=true convierte estos
# archivos a CRLF, y bash los rechaza con "bad interpreter: ...^M".
* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.conf text eol=lf
*.ini text eol=lf
.env.example text eol=lf

# Binarios: nunca tocar
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.tar.gz binary
*.zip binary
