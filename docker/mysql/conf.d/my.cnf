[mysqld]
# Configuracion de MySQL para Artesanal Chocolate Diego
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '-06:00'

# El esquema usa columnas generadas y restricciones CHECK: el modo estricto
# debe permanecer activo para que las reglas del negocio se cumplan.
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,ERROR_FOR_DIVISION_BY_ZERO,NO_ZERO_DATE,NO_ZERO_IN_DATE

default_storage_engine   = InnoDB
innodb_buffer_pool_size  = 256M
innodb_flush_log_at_trx_commit = 1
max_connections          = 100

# Las funciones del esquema leen tablas; con la bitacora binaria activa MySQL
# exige declararlas o confiar en el creador.
log_bin_trust_function_creators = 1

slow_query_log      = 1
slow_query_log_file = /var/lib/mysql/lento.log
long_query_time     = 2
