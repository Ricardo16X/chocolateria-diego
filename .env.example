# =============================================================================
# Artesanal Chocolate Diego — variables de entorno
# Copiar a .env y completar. El archivo .env nunca se versiona.
# =============================================================================

# --- Aplicacion -------------------------------------------------------------
# Solo APP_VERSION: es la unica que usa docker-compose.yml (tag de las
# imagenes). El resto de la configuracion de Laravel (APP_KEY, APP_ENV,
# APP_DEBUG, APP_URL, APP_NAME, APP_TIMEZONE, APP_LOCALE...) vive
# exclusivamente en src/.env. Este archivo se pasa entero a los contenedores
# via "env_file", y una variable de aplicacion definida aca (aunque sea
# vacia, como quedaba APP_KEY) gana sobre el valor real de src/.env: el
# proceso ya trae la variable puesta cuando arranca, y phpdotenv nunca
# sobreescribe una variable de entorno que ya existe.
APP_VERSION=dev

# --- Puertos publicados en el equipo ----------------------------------------
WEB_PORT=8080
MAILPIT_PORT=8025
DB_PORT_HOST=3307
REDIS_PORT_HOST=6380

# --- Base de datos ----------------------------------------------------------
MYSQL_VERSION=8.0
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=chocolate_diego
DB_USERNAME=chocolate
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_esta_clave_root

# --- Cache, sesiones y colas ------------------------------------------------
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# --- Correo -----------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="pedidos@chocolatediego.com"
MAIL_FROM_NAME="Artesanal Chocolate Diego"

# --- Facturacion electronica FEL-SAT ----------------------------------------
# Se completan cuando se contrate el certificador autorizado. Los parametros
# de negocio (tasa de IVA, reintentos maximos de certificacion, etc.) NO van
# aqui: viven en la tabla parametro_sistema (fel.tasa_iva, fel.intentos_maximos)
# para poder ajustarse sin redesplegar. Este archivo solo trae credenciales de
# conexion al certificador.
FEL_ENDPOINT=
FEL_USUARIO=
FEL_LLAVE=
FEL_NIT_EMISOR=

# --- Almacenamiento en la nube ----------------------------------------------
FILESYSTEM_DISK=local
AZURE_STORAGE_NAME=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
